    "Siri only accepts whole numbers for now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri akzeptiert derzeit nur ganze Zahlen."
          }
        }
      }
    },
    "Siri reserves words like 'battery' for your iPhone's own battery - say 'SoC' or 'charge percentage' instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri hat Wörter wie „Batterie“ für Deinen iPhone-Akku reserviert - Benutz daher „SoC“."
